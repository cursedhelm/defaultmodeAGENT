# Per bot tokens and keys, match defined agent/prompts/botname folders when configuring

DISCORD_TOKEN_GROSSBOT=
GITHUB_TOKEN_GROSSBOT=
GITHUB_REPO_GROSSBOT=

DISCORD_TOKEN_LOOP=
GITHUB_TOKEN_LOOP=
GITHUB_REPO_LOOP=

DISCORD_TOKEN_CASFY=
GITHUB_TOKEN_CASFY=
GITHUB_REPO_CASFY=

DISCORD_TOKEN=
GITHUB_TOKEN=
GITHUB_REPO=

POLL_INTERVAL=120
LOGLEVEL=INFO
LOG_LEVEL=INFO

# Service API Keys

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VLLM_API_KEY=
OPENROUTER_API_KEY=
UNSLOTH_API_KEY=
UNSLOTH_REQUIRE_AUTH=false
UNSLOTH_API_BASE=http://localhost:8888
UNSLOTH_MODEL_NAME=gemma-4-26B-A4B-it-GGUF

# Optional provider controls. Replace UNSLOTH with OPENAI, OLLAMA,
# LLAMA_SERVER, VLLM, OPENROUTER, ANTHROPIC, or GEMINI where supported.
UNSLOTH_TOP_K=20
UNSLOTH_MIN_P=0.05
UNSLOTH_REPETITION_PENALTY=1.1
UNSLOTH_MAX_OUTPUT_TOKENS=12000
UNSLOTH_ENABLE_THINKING=true
UNSLOTH_REASONING_EFFORT=medium
UNSLOTH_REASONING_BUDGET_TOKENS=2048
UNSLOTH_CAPTURE_REASONING=true
UNSLOTH_ENABLE_TOOLS=false
UNSLOTH_ENABLED_TOOLS=web_search,python,terminal
UNSLOTH_EMBED_MODEL=

# Claude 4.6+ supports adaptive thinking; older thinking models use enabled.
# Leave blank to select the mode from the configured model name.
ANTHROPIC_THINKING_TYPE=

# Shared user/bot todo lists and semantic ranking
TODO_ENABLED=true
TODO_DATABASE_PATH=cache/shared/todos.sqlite3
TODO_MAX_ITEMS=5
TODO_EMBED_PROVIDER=ollama
TODO_EMBED_MODEL=all-minilm:latest
TODO_MAX_EMBED_TOKENS=256
TODO_REMOVE_THRESHOLD=0.55
TODO_AMBIGUITY_MARGIN=0.05
# Optional one-time import source containing todont's <discord_id>.md files.
TODO_IMPORT_DIRECTORY=
