# Per bot tokens and keys, match defined agent/prompts/botname folders when configuring

DISCORD_TOKEN_GROSSBOT=
GITHUB_TOKEN_GROSSBOT=
GITHUB_REPO_GROSSBOT=

DISCORD_TOKEN_LOOP=
GITHUB_TOKEN_LOOP=
GITHUB_REPO_LOOP=

DISCORD_TOKEN_CASFY=
GITHUB_TOKEN_CASFY=
GITHUB_REPO_CASFY=

DISCORD_TOKEN=
GITHUB_TOKEN=
GITHUB_REPO=

POLL_INTERVAL=120
GLOBAL_TICK_RATE=800
LOGLEVEL=INFO
LOG_LEVEL=INFO

# Service API Keys

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VLLM_API_KEY=
OPENROUTER_API_KEY=
UNSLOTH_API_KEY=
UNSLOTH_REQUIRE_AUTH=false
UNSLOTH_API_BASE=http://localhost:8888
UNSLOTH_MODEL_NAME=gemma-4-26B-A4B-it-GGUF

# Optional provider controls. Replace UNSLOTH with OPENAI, OLLAMA,
# LLAMA_SERVER, VLLM, OPENROUTER, ANTHROPIC, or GEMINI where supported.
UNSLOTH_TOP_K=20
UNSLOTH_MIN_P=0.05
UNSLOTH_REPETITION_PENALTY=1.1
UNSLOTH_MAX_OUTPUT_TOKENS=12000
UNSLOTH_ENABLE_THINKING=true
UNSLOTH_REASONING_EFFORT=medium
UNSLOTH_REASONING_BUDGET_TOKENS=2048
UNSLOTH_CAPTURE_REASONING=true
UNSLOTH_ENABLE_TOOLS=false
UNSLOTH_ENABLED_TOOLS=web_search,python,terminal
UNSLOTH_EMBED_MODEL=

# Claude 4.6+ supports adaptive thinking; older thinking models use enabled.
# Leave blank to select the mode from the configured model name.
ANTHROPIC_THINKING_TYPE=

# Shared user/bot todo lists and semantic ranking
TODO_ENABLED=true
TODO_DATABASE_PATH=cache/shared/todos.sqlite3
TODO_MAX_ITEMS=5
TODO_EMBED_PROVIDER=ollama
TODO_EMBED_MODEL=all-minilm:latest
TODO_MAX_EMBED_TOKENS=256
TODO_REMOVE_THRESHOLD=0.55
TODO_AMBIGUITY_MARGIN=0.05
# Optional one-time import source containing todont's <discord_id>.md files.
TODO_IMPORT_DIRECTORY=

# Each agent stores its own managed library under cache/<agent>/bookshelf.
BOOKSHELF_ENABLED=true
BOOKSHELF_DATABASE=bookshelf.sqlite3
BOOKSHELF_MAX_FILE_BYTES=104857600
BOOKSHELF_CHUNK_TOKENS=1200
BOOKSHELF_EMBED_PROVIDER=ollama
BOOKSHELF_EMBED_MODEL=all-minilm:latest
BOOKSHELF_MAX_EMBED_TOKENS=1200
BOOKSHELF_EMBED_BATCH_SIZE=16
BOOKSHELF_INGESTION_STALE_SECONDS=3600
BOOKSHELF_HYBRID_BLEND=0.45
BOOKSHELF_CANDIDATE_POOL=64
BOOKSHELF_SEMANTIC_SCAN_LIMIT=5000
BOOKSHELF_MAX_MEDIA_PER_CHUNK=4

# READER inference can use a different endpoint/model from chat and DMN.
READER_ENABLED=true
# Optional; blank makes READER use GLOBAL_TICK_RATE.
READER_TICK_RATE=
READER_API_TYPE=
READER_MODEL=
READER_TEMPERATURE=0.7
READER_MEMORY_CANDIDATES=32
READER_MEMORY_LIMIT=12
READER_PRIOR_LIMIT=8
READER_MEMORY_TRUNCATION=256
READER_CONTEXT_TOKENS=6000
READER_SELECTION_LIMIT=5
READER_PRIOR_SCOPE=global

# SEEKING actions triggered when DMN pruning leaves an unresolved association.
SPIKE_ENABLED=true
SPIKE_DATABASE=spike.sqlite3
SPIKE_CONTEXT_MESSAGES=50
SPIKE_MAX_EXPANSION=150
SPIKE_EXPANSION_STEP=25
SPIKE_MATCH_THRESHOLD=0.35
SPIKE_COMPRESSION_RATIO=0.6
SPIKE_COOLDOWN_SECONDS=120
SPIKE_MAX_SURFACES=8
SPIKE_RECENCY_HOURS=512
SPIKE_MEMORY_K=12
SPIKE_MEMORY_TRUNCATION=512
SPIKE_THEME_WEIGHT=0.3
SPIKE_MAX_TOOL_ACTIONS=3
SPIKE_MAX_ATTEMPTS_PER_MEMORY=1
SPIKE_DECISION_TEMPERATURE=0.5
SPIKE_ALLOW_CHANNELS=true
SPIKE_ALLOW_DMS=true
SPIKE_ALLOW_TOOLS=true
SPIKE_ALLOW_MEMORY_SEARCH=true
SPIKE_RELEASE_ON_SILENCE=true
